# ==============================================================================
# VoxLore: Voice-Enabled Multilingual RAG System Configuration
# HH Goa 2026 Shortlisting Task 2
# ==============================================================================

# --- 1. SPEECH-TO-TEXT (Sarvam AI) ---
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_STT_URL=https://api.sarvam.ai/speech-to-text
SARVAM_MODEL=saaras:v3

# --- 2. DENSE RETRIEVAL (Embedder) ---
# Model: intfloat/multilingual-e5-small (384-dim, ~12ms P95 on CPU)
# Budget: < 50.0 ms retrieval latency
EMBED_MODEL=intfloat/multilingual-e5-small
EMBED_DIM=384
TOP_K=5

# --- 3. ANSWER GENERATION (Local GPU LLM) ---
# Model: Qwen/Qwen2.5-1.5B-Instruct (FP16 on CUDA RTX 4050)
# VRAM Usage: ~3.2 GB | Generation P95: ~1,277 ms
LLM_MODEL=Qwen/Qwen2.5-1.5B-Instruct
MAX_NEW_TOKENS=38

# --- 4. CROSS-ENCODER RELEVANCE GATE ---
# Model: cross-encoder/ms-marco-MiniLM-L-6-v2 (~15ms per batch)
CE_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
CE_THRESHOLD=5.6
CE_THRESHOLD_DEF=2.8

# --- 5. EVALUATION (OpenAI Judge for rag-local-eval-loop) ---
# Only used by eval.runner for LLM-as-Judge scoring, NOT for answer generation
OPENAI_API_KEY=your_openai_key_here

# --- 6. HUGGING FACE (for gated models, optional) ---
HF_TOKEN=your_hf_token_here

# --- 7. DEPLOYMENT ENDPOINTS (Modal & Vercel) ---
MODAL_API_URL=https://rawrmeinkayanosaurushun--voice-rag-voicerag-fastapi-app.modal.run
FRONTEND_URL=https://voxlore-six.vercel.app
