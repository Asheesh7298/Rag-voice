# ==============================================================================
# VoxLore: Sub-200ms Multilingual Voice RAG Configuration
# ==============================================================================

# --- 1. SPEECH-TO-TEXT (Sarvam AI) ---
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_STT_URL=https://api.sarvam.ai/speech-to-text
SARVAM_MODEL=saaras:v3

# --- 2. VECTOR SEARCH & HYBRID RETRIEVAL ---
EMBED_MODEL=intfloat/multilingual-e5-base
EMBED_DIM=768
TOP_K=10
RERANK_TOP_N=50
INDEX_LANGUAGES=en,hi,mr

# --- 3. EXTRACTIVE QA READER (No Generative LLM) ---
QA_MODEL=deepset/xlm-roberta-base-squad2
MAX_QA_INPUT_LENGTH=256

# --- 4. GUARDRAILS & NLI ENTAILMENT ---
OFF_TOPIC_THRESHOLD=0.70
MIN_RETRIEVAL_SCORE=0.65
MIN_QA_SCORE=0.0005
MIN_ANSWER_RELEVANCE=0.20

# NLI Model for Zero-Hallucination Verification
NLI_MODEL=MoritzLaurer/mDeBERTa-v3-base-xnli-multilingual-nli-2mil7
NLI_CHECK_MIN=0.15
NLI_CHECK_MAX=0.35
TIME_BUDGET_CEILING_MS=175.0

# --- 5. DEPLOYMENT ENDPOINTS (Modal & Vercel) ---
MODAL_API_URL=https://healthbaba25--voice-rag-voicerag-fastapi-app.modal.run
FRONTEND_URL=https://voxlore-six.vercel.app
