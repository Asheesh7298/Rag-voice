# VoxLore backend settings.
# On Modal these live in the Secret "voice-rag-secrets", which modal_app.py reads as environment variables:
#   modal secret create voice-rag-secrets SARVAM_API_KEY=... [any of the optional values below]
# The web app's setting (VITE_API_URL) is in frontend/.env.example.

# Required for voice questions (speech-to-text)
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_STT_URL=https://api.sarvam.ai/speech-to-text

# Optional tuning; the values shown are the defaults in modal_app.py
TOP_K=8                      # sources returned and passed to the QA reader
RERANK_TOP_N=35              # vector-search candidates reranked per question
MIN_RETRIEVAL_SCORE=0.65     # decline if the best reranked score is lower
MIN_QA_SCORE=0.0005          # decline if the best answer span is less likely
MIN_ANSWER_RELEVANCE=0.20    # decline a weak answer that is not similar to the question
OFF_TOPIC_COSINE=0           # raw-cosine off-topic gate; 0 = off (see eval/results_phase6.md)
